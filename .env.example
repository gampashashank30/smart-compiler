# ─────────────────────────────────────────────────────────────────────────────
# smart-compiler — Environment Variables Template
#
# Copy this file to .env and fill in your own keys.
# NEVER commit .env to version control.
#
# For production on Hetzner + Coolify:
#   Set all these in Coolify Dashboard → Your App → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key (https://openrouter.ai/keys)
# Model: Meta: Llama 3.3 70B Instruct (meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase (https://supabase.com/dashboard/project/<your-project>/settings/api)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — bypasses RLS. Never expose to frontend. Server-side only.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Admin emails — comma-separated, get access to Admin dashboard & full /api/health diagnostics.
# Example: ADMIN_EMAILS=you@example.com,colleague@example.com
ADMIN_EMAILS=your_admin_email@example.com

# ── Hetzner / Coolify Production Settings ────────────────────────────────────
# Port the server listens on (Coolify maps this to 80/443 automatically)
PORT=10000

# Set to production on Hetzner
NODE_ENV=production

# Optional: Add your domain here to allow it in CORS (if not already in ALLOWED_ORIGINS)
# EXTERNAL_URL=https://smartcompiler.maadiotsolutions.co.in
